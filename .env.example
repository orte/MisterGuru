# Copia este archivo a .env y rellena los valores desde DevTools (sesión iniciada
# en mister.mundodeportivo.com). Nunca subas .env ni pegues estos valores en un chat.

# Cookie `token` (JWT de sesión)
MISTER_TOKEN=
# Cabecera `x-auth` de las peticiones /ajax/*
MISTER_X_AUTH=
# Cookie `PHPSESSID`
MISTER_PHPSESSID=
# Cookie `refresh-token` (opcional)
MISTER_REFRESH_TOKEN=

# Opcionales
# MISTER_BASE_URL=https://mister.mundodeportivo.com
# MISTER_MIN_INTERVAL_S=2.5
# LOG_LEVEL=INFO

# Postgres de Supabase: Connect → "Session pooler" (IPv4). NO es la URL https de la API.
# postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Avisos por Telegram (bot de @BotFather y el id de tu chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
